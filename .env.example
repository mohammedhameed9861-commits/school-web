# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Optional — GA only loads
# once a visitor accepts the "analytics" cookie category.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID. Optional — only loads once a visitor accepts the
# "marketing" cookie category.
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# Optional upstream the /api/admissions route forwards applications to
# (CRM / webhook). When unset, the route logs submissions server-side instead.
ADMISSIONS_ENDPOINT=
